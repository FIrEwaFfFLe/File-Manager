<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin">

    <org.fossify.commons.views.MyTextInputLayout
        android:id="@+id/folder_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_margin"
        android:hint="@string/folder">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/folder"
            style="@style/UnclickableEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </org.fossify.commons.views.MyTextInputLayout>

    <org.fossify.commons.views.MyTextInputLayout
        android:id="@+id/filename_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/folder_hint"
        android:hint="@string/filename_without_zip">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/filename_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/bigger_text_size" />

    </org.fossify.commons.views.MyTextInputLayout>

    <org.fossify.commons.views.MyTextInputLayout
        android:id="@+id/max_archive_size_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/filename_hint"
        android:layout_marginTop="@dimen/small_margin"
        android:hint="@string/max_archive_size_mib">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/max_archive_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:singleLine="true"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/normal_text_size" />
    </org.fossify.commons.views.MyTextInputLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/archive_size_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/max_archive_size_hint"
        android:layout_marginTop="@dimen/small_margin"
        android:text="@string/smart_compression_limit_explanation"
        android:textSize="@dimen/small_text_size" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/archive_size_presets_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/archive_size_help"
        android:layout_marginTop="@dimen/small_margin"
        android:text="@string/fat32_archive_presets"
        android:textSize="@dimen/small_text_size" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/archive_size_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/archive_size_presets_label"
        android:layout_marginTop="@dimen/small_margin"
        app:singleLine="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/preset_two_gib"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2048 MiB" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset_three_gib"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3072 MiB" />

        <com.google.android.material.chip.Chip
            android:id="@+id/preset_three_point_five_gib"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3584 MiB" />
    </com.google.android.material.chip.ChipGroup>

    <org.fossify.commons.views.MyAppCompatCheckbox
        android:id="@+id/password_protect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/archive_size_presets"
        android:layout_marginTop="@dimen/small_margin"
        android:paddingTop="@dimen/normal_margin"
        android:paddingBottom="@dimen/normal_margin"
        android:text="@string/add_password" />

    <org.fossify.commons.views.MyTextInputLayout
        android:id="@+id/enter_password_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/password_protect"
        android:hint="@string/password"
        android:visibility="gone"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/activity_margin"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/normal_text_size" />

    </org.fossify.commons.views.MyTextInputLayout>
</RelativeLayout>
