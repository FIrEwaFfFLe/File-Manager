<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/recents_settings_appbar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/recents_settings_toolbar" android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" android:background="@color/color_primary"
            app:title="@string/recents_settings" app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />
    </org.fossify.commons.views.MyAppBarLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/recents_settings_scroll"
        android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RelativeLayout android:id="@+id/recents_limit_holder" style="@style/SettingsHolderTextViewStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <org.fossify.commons.views.MyTextView android:id="@+id/recents_limit_label"
                    style="@style/SettingsTextLabelStyle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/maximum_recent_files" />
                <org.fossify.commons.views.MyTextView android:id="@+id/recents_limit_value"
                    style="@style/SettingsTextLabelStyle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
            <TextView style="@style/SettingsSectionLabelStyle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/included_file_types" />
            <RelativeLayout style="@style/SettingsHolderSwitchStyle" android:layout_width="match_parent" android:layout_height="wrap_content">
                <org.fossify.commons.views.MyMaterialSwitch android:id="@+id/recents_images"
                    style="@style/SettingsSwitchStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/images" />
            </RelativeLayout>
            <RelativeLayout style="@style/SettingsHolderSwitchStyle" android:layout_width="match_parent" android:layout_height="wrap_content">
                <org.fossify.commons.views.MyMaterialSwitch android:id="@+id/recents_videos"
                    style="@style/SettingsSwitchStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/videos" />
            </RelativeLayout>
            <RelativeLayout style="@style/SettingsHolderSwitchStyle" android:layout_width="match_parent" android:layout_height="wrap_content">
                <org.fossify.commons.views.MyMaterialSwitch android:id="@+id/recents_other"
                    style="@style/SettingsSwitchStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/other_files" />
            </RelativeLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
